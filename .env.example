# TransApp — Environment Variables
# Скопируй в .env и заполни значения (локальная разработка).
# ПРОД: переменные задаются в UI Coolify (см. docs/DEPLOY-COOLIFY.md),
# а не в этом файле. Имена должны совпадать с ${VAR} в docker-compose.coolify.yml.
# ============================================================

# ── Monobank (Acquiring API) ──────────────────────────────────
# Получить токен: https://api.monobank.ua → регистрация мерчанта
MONOBANK_TOKEN=
MONOBANK_WEBHOOK_URL=https://api.transapp.dev/webhook/monobank
MONOBANK_CURRENCY=980
MONOBANK_AMOUNT_PER_STAR=2.1

# ── Ko-fi ──────────────────────────────────────────────────────
# Получить токен: https://ko-fi.com → Settings → Payment Settings
KOFI_VERIFICATION_TOKEN=
KOFI_PAGE_URL=https://ko-fi.com/evgeniy_g
KOFI_CURRENCY=USD
KOFI_AMOUNT_PER_STAR=0.05

# ── PayPal ─────────────────────────────────────────────────────
# Получить: https://developer.paypal.com → создать REST API приложение
# По умолчанию выключен — включить через админ-панель бота
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_AMOUNT_PER_STAR=0.05

# ── Telegram Bot ──────────────────────────────────────────────
BOT_TOKEN=
BOT_WEBHOOK_SECRET=
BOT_INTERNAL_SECRET=change-me-bot-secret
MINI_APP_URL=https://your-domain.com/miniapp

# ── База данных ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://transapp:password@localhost:5432/transapp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SHORT=86400
CACHE_TTL_LONG=604800

# ── Translation ────────────────────────────────────────────────
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
OPENAI_API_KEY=
DEFAULT_TRANSLATION_ENGINE=google_free

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-min-64-chars
TELEGRAM_ID_ENCRYPTION_KEY=32_byte_aes_key_base64_encoded

# ── Admin ──────────────────────────────────────────────────────
ADMIN_TG_IDS=

# ── Quotas (override defaults) ────────────────────────────────
FREE_PLAN_CHARS=25000
REFERRAL_BONUS_CHARS=10000

# ── App ───────────────────────────────────────────────────────
ENV=development
DEBUG=True
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

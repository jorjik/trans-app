# ============================================================
# TransApp — Environment Variables
# Скопируй в .env и заполни значения
# ============================================================

# --- Telegram ---
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_SECRET=random_secret_string_32chars
MINI_APP_URL=https://your-domain.com/miniapp

# --- Database ---
DATABASE_URL=postgresql+asyncpg://transapp:password@localhost:5432/transapp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=your_secret_key_64chars_minimum
TELEGRAM_ID_ENCRYPTION_KEY=32_byte_aes_key_base64_encoded

# --- Translation Providers ---
DEEPL_API_KEY=your_deepl_api_key
GOOGLE_TRANSLATE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key

# Default provider: auto | deepl | google | openai
DEFAULT_TRANSLATION_ENGINE=auto

# --- Billing ---
TELEGRAM_PAYMENT_TOKEN=your_payment_token
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- App Config ---
ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["https://your-domain.com"]

# --- Quotas (override defaults) ---
FREE_PLAN_CHARS=50000
REFERRAL_BONUS_CHARS=10000
CACHE_TTL_SHORT=86400
CACHE_TTL_LONG=604800

# --- Admin ---
ADMIN_TG_IDS=[123456789,987654321]
ADMIN_CHAT_ID=-1001234567890

# Скопируй этот файл как .env и заполни BOT_TOKEN
BOT_TOKEN=your_bot_token_here
MINI_APP_URL=https://example.com/miniapp

# Провайдеры перевода (необязательно для MVP — используется бесплатный Google)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
OPENAI_API_KEY=

# Redis (необязательно, для MVP хранение в памяти)
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0

# Квоты
FREE_PLAN_CHARS=50000
REFERRAL_BONUS_CHARS=10000

# Backend API (синхронизация оплаты Stars → quota в БД)
BACKEND_API_URL=http://localhost:8000
BOT_WEBHOOK_SECRET=random_secret_string_32chars

# Разработка
ENV=development
LOG_LEVEL=INFO
ADMIN_TG_IDS=
